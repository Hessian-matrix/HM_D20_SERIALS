msgstr "`sensor_msgs/NavSatFix`"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:26
msgid "经纬度、椭球高、时间戳、定位状态和协方差"
msgstr ""
"Latitude and longitude, ellipsoidal height, timestamp, positioning "
"status, and covariance"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:26
msgid "`/rtk_nmea`"
msgstr "`/rtk_nmea`"

