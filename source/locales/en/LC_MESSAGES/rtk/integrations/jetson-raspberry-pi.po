#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
msgid "独立的 5 V ±0.5 V 电源正极"
msgstr "Independent 5 V ±0.5 V power supply positive supply lead"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:35
msgid ""
"Pin 2/3 为磁力计 SDA/SCL，Pin 8 为 3.3 V PPS，本页的 ROS 定位接入不使用它们。"
msgstr ""
"Pins 2/3 are magnetometer SDA/SCL; Pin 8 is 3.3 V PPS. This ROS integration "
"does not use them."

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:37
msgid "D13 接 Jetson / 树莓派"
msgstr "D13 Connect Jetson / Raspberry Pi"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:39
msgid "D13 移动站使用 5-pin GH1.25 mm 接口："
msgstr "D13 rover uses a 5-pin GH1.25 mm interface:"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
msgid "D13 Pin"
msgstr "D13 Pin"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
msgid "1"
msgstr "1"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
msgid "主控 GND / 电源负极"
msgstr "Main Control GND / Power Negative"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
msgid "2"
msgstr "2"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
msgid "VCC"
msgstr "VCC"

#: ../../source/rtk/integrations/jetson-raspberry-pi.md:9
