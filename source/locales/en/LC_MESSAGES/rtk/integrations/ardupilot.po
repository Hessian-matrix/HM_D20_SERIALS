msgid "GPS"
msgstr "GPS"

#: ../../source/rtk/integrations/ardupilot.md:13
msgid "波特率"
msgstr "Baud rate"

#: ../../source/rtk/integrations/ardupilot.md:13
msgid "115200 bps"
msgstr "115200 bps"

