#: ../../source/products/models/hm-d20-4g.md:32
msgid "NMEA 或 UBX；地面版默认 10 Hz NMEA，无人机版默认 10 Hz UBX"
msgstr ""
"NMEA or UBX; the ground firmware defaults to 10 Hz NMEA, and the UAV "
"firmware defaults to 10 Hz UBX"

#: ../../source/products/models/hm-d20-4g.md:32
msgid "RTK 最高更新率"
msgstr "Maximum RTK update rate"

#: ../../source/products/models/hm-d20-4g.md:32
