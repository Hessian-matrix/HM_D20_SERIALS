#: ../../source/products/models/hm-d20-4g.md:32
msgid "8-pin GH1.25 mm；UART/PPS I/O 3.3 V；默认 115200 bps"
msgstr "8-pin GH1.25 mm; 3.3 V UART/PPS I/O; default 115200 bps"

