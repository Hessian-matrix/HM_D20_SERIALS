msgstr "Link topology"

#: ../../source/products/models/hm-d13-lora.md:34
msgid "单基站；一对一或一对多；最多 4096 个移动站"
msgstr "Single base station; one-to-one or one-to-many; up to 4096 rovers"

#: ../../source/products/models/hm-d13-lora.md:34
msgid "通信距离"
msgstr "Communication range"

#: ../../source/products/models/hm-d13-lora.md:34
msgid "最远约 6 km"
msgstr "Up to approximately 6 km"

#: ../../source/products/models/hm-d13-lora.md:34
